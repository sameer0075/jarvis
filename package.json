{
  "name": "jarvis-ai",
  "version": "1.0.0",
  "description": "Jarvis AI Assistant with Chat, Voice & URL Browser",
  "scripts": {
    "install:all": "npm install && cd client && npm install",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm run dev",
    "start": "npm run dev"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "concurrently": "^8.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "fuse.js": "^7.3.0",
    "mime-types": "^3.0.2",
    "mongoose": "^8.24.0",
    "os": "^0.1.2",
    "rss-parser": "^3.13.0",
    "systeminformation": "^5.31.6",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
